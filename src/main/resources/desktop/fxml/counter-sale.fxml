<?xml version="1.0" encoding="UTF-8"?>

<?import com.fu.cinema.desktop.component.SeatMapView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fu.cinema.desktop.controller.CounterSaleController">
    <left>
        <VBox spacing="10.0" prefWidth="320.0">
            <BorderPane.margin>
                <Insets right="16.0"/>
            </BorderPane.margin>
            <Label text="BÁN VÉ TẠI QUẦY" styleClass="page-title"/>

            <Label text="1. Tìm &amp; chọn khách hàng *"/>
            <TextField fx:id="tfCustomer" promptText="Tìm khách: tên / email / SĐT"/>
            <ListView fx:id="lvCustomers" prefHeight="160.0" VBox.vgrow="ALWAYS"/>

            <Label text="2. Chọn phim *"/>
            <ComboBox fx:id="cbMovie" promptText="Chọn phim đang/sắp chiếu" maxWidth="Infinity"/>

            <Label text="3. Chọn suất chiếu *"/>
            <ComboBox fx:id="cbShowtime" promptText="Chọn suất chiếu" maxWidth="Infinity"/>

            <Separator/>

            <Label fx:id="lblSeats" text="Ghế: " wrapText="true" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblTotal" text="Tổng: 0 đ" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e50914;"/>
            <CheckBox fx:id="chkPaid" text="Đã thanh toán (Xác nhận ngay)" selected="true"/>

            <Button fx:id="btnSell" text="Bán vé" onAction="#onSell" styleClass="primary" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <padding>
                <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
            </padding>
            <SeatMapView fx:id="seatMap"/>
        </ScrollPane>
    </center>
</BorderPane>

