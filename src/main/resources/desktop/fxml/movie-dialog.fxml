<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.fu.cinema.desktop.controller.MovieDialogController"
        fx:id="root" hgap="12" vgap="10" prefWidth="570">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <columnConstraints>
        <ColumnConstraints minWidth="125"/>
        <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>

    <Label text="Tên phim *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="tfTitle" promptText="Nhập tên phim" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label text="Đạo diễn *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="tfDirector" promptText="Nhập tên đạo diễn" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Label text="Thời lượng *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <Spinner fx:id="spDuration" editable="true" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Label text="Ngày khởi chiếu *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <DatePicker fx:id="dpRelease" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    <Label text="Độ tuổi *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <ComboBox fx:id="cbAgeRating" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    <Label text="Thể loại *" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <ComboBox fx:id="cbGenre" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    <Label text="Trạng thái *" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
    <ComboBox fx:id="cbStatus" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    <Label text="Poster URL" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
    <TextField fx:id="tfPoster" promptText="https://..." maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    <Label text="Mô tả" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
    <TextArea fx:id="taDescription" promptText="Nhập mô tả phim" wrapText="true" prefRowCount="4" maxWidth="Infinity" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
</GridPane>
