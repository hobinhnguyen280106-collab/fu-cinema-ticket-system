<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.MovieController"
      spacing="12"
      styleClass="page">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Quản lý phim" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Thêm phim" onAction="#onAdd" styleClass="primary"/>
    </HBox>
    <!-- Filters -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="tfSearch" promptText="Tìm theo tên phim..." prefWidth="220"/>
        <ComboBox fx:id="cbGenre" promptText="Thể loại" prefWidth="150"/>
        <ComboBox fx:id="cbStatus" promptText="Trạng thái" prefWidth="150"/>
        <ComboBox fx:id="cbSort" promptText="Sắp xếp" prefWidth="170"/>
        <Button fx:id="btnRefresh" text="Làm mới" onAction="#onRefresh"/>
        <ProgressIndicator fx:id="loading" prefWidth="24" prefHeight="24" visible="false"/>
    </HBox>

    <!-- Movie Table -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="450">
        <columns>
            <TableColumn fx:id="colTitle" text="Tên phim" prefWidth="270"/>
            <TableColumn fx:id="colGenre" text="Thể loại" prefWidth="130"/>
            <TableColumn fx:id="colDuration" text="Thời lượng" prefWidth="100"/>
            <TableColumn fx:id="colRelease" text="Khởi chiếu" prefWidth="130"/>
            <TableColumn fx:id="colAge" text="Độ tuổi" prefWidth="95"/>
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="130"/>
        </columns>
    </TableView>

    <!-- Pagination -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="lblCount" text="0 phim"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Pagination fx:id="pagination" pageCount="1" maxPageIndicatorCount="7"/>
    </HBox>
</VBox>
